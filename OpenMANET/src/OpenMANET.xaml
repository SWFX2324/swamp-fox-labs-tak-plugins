<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="WinTAK_OpenMANET_Plugin.OpenMANET"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" Background="Transparent" FontFamily="Segoe UI" FontSize="12"
             TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <!-- Palette. Keys referenced from code-behind: MetricBrush, WarningBrush, DangerBrush. -->
      <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1115" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="#171A20" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1E222A" />
      <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#262B35" />
      <SolidColorBrush x:Key="InsetBrush" Color="#12151A" />
      <SolidColorBrush x:Key="GridLineBrush" Color="#1F242D" />
      <SolidColorBrush x:Key="BorderBrush" Color="#2A2F3A" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4150" />
      <SolidColorBrush x:Key="AccentBrush" Color="#4C9AFF" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#6AACFF" />
      <SolidColorBrush x:Key="AccentTintBrush" Color="#17284A" />
      <SolidColorBrush x:Key="SelectedBrush" Color="#1A2740" />
      <SolidColorBrush x:Key="MetricBrush" Color="#2DD4BF" />
      <SolidColorBrush x:Key="BandwidthBrush" Color="#A78BFA" />
      <SolidColorBrush x:Key="InfoBrush" Color="#62A8EA" />
      <SolidColorBrush x:Key="TxBrush" Color="#F2B54A" />
      <SolidColorBrush x:Key="SuccessBrush" Color="#3DD68C" />
      <SolidColorBrush x:Key="SuccessTintBrush" Color="#133527" />
      <SolidColorBrush x:Key="WarningBrush" Color="#F2B54A" />
      <SolidColorBrush x:Key="WarningTintBrush" Color="#3A2D14" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F26D6D" />
      <SolidColorBrush x:Key="DangerTintBrush" Color="#3A1A1C" />
      <SolidColorBrush x:Key="AvatarBrush" Color="#263042" />
      <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EAED" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3A9B5" />
      <SolidColorBrush x:Key="MutedTextBrush" Color="#6B7280" />

      <!-- Typography -->
      <Style TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      </Style>
      <Style x:Key="EyebrowTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style x:Key="SecondaryTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      </Style>
      <Style x:Key="CaptionTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="KpiValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      </Style>
      <Style x:Key="KpiUnitTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="4,0,0,4" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      </Style>
      <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Margin" Value="0,4,0,8" />
      </Style>
      <Style x:Key="LabelTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,0,8,7" />
      </Style>
      <Style x:Key="ValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,0,0,7" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>

      <!-- Status pills: Online / Discovering / Stale (and Healthy / Degraded / Offline). -->
      <Style x:Key="StatusPillStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2,9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding StatusDisplay}" Value="Online">
            <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding StatusDisplay}" Value="Discovering">
            <Setter Property="Background" Value="{StaticResource AccentTintBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="StatusPillTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="Text" Value="{Binding StatusDisplay}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding StatusDisplay}" Value="Online">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding StatusDisplay}" Value="Discovering">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="StatusDotStyle" TargetType="{x:Type Ellipse}">
        <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding StatusDisplay}" Value="Online">
            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
          </DataTrigger>
          <DataTrigger Binding="{Binding StatusDisplay}" Value="Discovering">
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="HealthTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Style.Triggers>
          <Trigger Property="Text" Value="Healthy">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
          </Trigger>
          <Trigger Property="Text" Value="Degraded">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
          </Trigger>
          <Trigger Property="Text" Value="Discovering">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SignalBarStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="3" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="RadiusX" Value="1" />
        <Setter Property="RadiusY" Value="1" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Fill" Value="{StaticResource BorderStrongBrush}" />
      </Style>

      <!-- Surfaces -->
      <Style x:Key="CardBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
      </Style>
      <Style x:Key="InsetBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
      </Style>
      <Style TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Padding" Value="14,10,14,14" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type GroupBox}">
              <Border BorderThickness="1" CornerRadius="12" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <ContentPresenter Margin="14,12,14,0" ContentSource="Header" TextElement.FontSize="13" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource PrimaryTextBrush}" />
                  <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                </Grid>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Segmented tab strip -->
      <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabControl}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Margin="8,0" Padding="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                  <UniformGrid Rows="1" IsItemsHost="True" />
                </Border>
                <ContentPresenter Grid.Row="1" Margin="0,4,0,0" ContentSource="SelectedContent" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,7" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TabItem}">
              <Border Name="TabSurface" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="7">
                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                  <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Buttons -->
      <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4" />
                  <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0B1220" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- Inputs -->
      <Style TargetType="{x:Type TextBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="InputSurface" Property="BorderBrush" Value="#4A5263" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="InputSurface" Property="Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type PasswordBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type PasswordBox}">
              <Border Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="InputSurface" Property="BorderBrush" Value="#4A5263" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="InputSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="InputSurface" Property="Opacity" Value="0.55" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Name="Box" Width="18" Height="18" Margin="0,1,0,0" VerticalAlignment="Top" CornerRadius="5" BorderThickness="1.5" BorderBrush="{StaticResource BorderStrongBrush}" Background="{StaticResource InsetBrush}">
                  <Path Name="Check" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="#0B1220" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                </Border>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Box" Property="Background" Value="{StaticResource WarningBrush}" />
                  <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                  <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.5" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type ComboBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource InsetBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle">
          <Setter.Value>
            <Style TargetType="{x:Type ComboBoxItem}">
              <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border Name="ItemBorder" Margin="3,1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsHighlighted" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectedBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid>
                <Border Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" />
                <ContentPresenter Margin="11,0,34,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" TextElement.Foreground="{TemplateBinding Foreground}" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Grid Background="Transparent">
                        <Path Width="9" Height="5" Margin="0,0,13,0" HorizontalAlignment="Right" VerticalAlignment="Center" Data="M0,0 L4.5,5 L9,0" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      </Grid>
                    </ControlTemplate>
                  </ToggleButton.Template>
                </ToggleButton>
                <Popup Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                  <Border Margin="0,4,0,0" Padding="0,3" MaxHeight="260" BorderThickness="1" CornerRadius="8" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                    <ScrollViewer>
                      <ItemsPresenter />
                    </ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#4A5263" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                  <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="ComboSurface" Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Lists -->
      <Style TargetType="{x:Type ListBox}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
      </Style>
      <Style TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="ItemSurface" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="ItemSurface" Property="Background" Value="{StaticResource SelectedBrush}" />
                  <Setter TargetName="ItemSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Meters -->
      <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{StaticResource MetricBrush}" />
        <Setter Property="Background" Value="{StaticResource GridLineBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ProgressBar}">
              <Grid>
                <Border Name="PART_Track" CornerRadius="3" Background="{TemplateBinding Background}" />
                <Border Name="PART_Indicator" CornerRadius="3" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MetricProgressBarStyle" TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource {x:Type ProgressBar}}" />

      <!-- Thin overlay-style scrollbars -->
      <Style x:Key="ScrollPageButtonStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RepeatButton}">
              <Border Background="Transparent" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Thumb}">
              <Border Name="ThumbSurface" Margin="2" CornerRadius="3" Background="{StaticResource BorderStrongBrush}" />
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="ThumbSurface" Property="Background" Value="#525B6D" />
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                  <Setter TargetName="ThumbSurface" Property="Background" Value="#6B7280" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="Transparent">
                <Track Name="PART_Track" IsDirectionReversed="True">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                  </Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                  </Track.IncreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumbStyle}" />
                  </Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                  <Grid Background="Transparent">
                    <Track Name="PART_Track">
                      <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                      </Track.DecreaseRepeatButton>
                      <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButtonStyle}" />
                      </Track.IncreaseRepeatButton>
                      <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollThumbStyle}" />
                      </Track.Thumb>
                    </Track>
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToolTip}">
              <Border Padding="9,6" MaxWidth="340" Background="#232833" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7">
                <ContentPresenter TextElement.Foreground="{StaticResource PrimaryTextBrush}" TextElement.FontSize="11" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>

  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="16,14,16,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
        <Image Source="Assets/OpenMANET_Logo.png" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
        <TextBlock Text="OpenMANET" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Mesh transport awareness" Style="{StaticResource CaptionTextStyle}" Margin="0,1,0,0" />
      </StackPanel>
      <Border Grid.Column="2" Padding="10,5,12,6" CornerRadius="14" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse Name="ConnectionStatusIndicator" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
          <TextBlock Name="ConnectionStatusText" Text="Not Connected" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="190" />
        </StackPanel>
      </Border>
    </Grid>

    <TabControl Name="MainTabControl" Grid.Row="1" Margin="8,0,8,8">
      <!-- ============================== DASHBOARD ============================== -->
      <TabItem Header="Dashboard">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,8,8,4">
            <!-- KPI tiles -->
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                  <TextBlock Text="NODES ONLINE" Style="{StaticResource EyebrowTextStyle}" />
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Name="NodeCountText" Text="0" Style="{StaticResource KpiValueTextStyle}" Foreground="{StaticResource SuccessBrush}" />
                    <TextBlock Name="NodeTotalText" Text="of 0" Style="{StaticResource KpiUnitTextStyle}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Last poll " Style="{StaticResource CaptionTextStyle}" />
                    <TextBlock Name="LastPollText" Text="Never" Style="{StaticResource CaptionTextStyle}" Foreground="{StaticResource SecondaryTextBrush}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                  <TextBlock Text="BANDWIDTH" Style="{StaticResource EyebrowTextStyle}" />
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Name="BandwidthCurrentValueText" Text="—" Style="{StaticResource KpiValueTextStyle}" Foreground="{StaticResource BandwidthBrush}" />
                    <TextBlock Text="Mbps" Style="{StaticResource KpiUnitTextStyle}" />
                  </StackPanel>
                  <TextBlock Text="Direct-link capacity" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                  <TextBlock Text="THROUGHPUT" Style="{StaticResource EyebrowTextStyle}" />
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Name="ThroughputCurrentValueText" Text="—" Style="{StaticResource KpiValueTextStyle}" Foreground="{StaticResource MetricBrush}" />
                    <TextBlock Text="Mbps" Style="{StaticResource KpiUnitTextStyle}" />
                  </StackPanel>
                  <TextBlock Text="HaLow RX + TX" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                  <TextBlock Text="UTILIZATION" Style="{StaticResource EyebrowTextStyle}" />
                  <TextBlock Name="UtilizationCurrentValueText" Text="—" Margin="0,4,0,0" Style="{StaticResource KpiValueTextStyle}" Foreground="{StaticResource MetricBrush}" />
                  <ProgressBar Name="UtilizationProgressBar" Style="{StaticResource MetricProgressBarStyle}" Value="0" Margin="0,7,0,2" />
                </StackPanel>
              </Border>
            </Grid>

            <GroupBox Header="Mesh Nodes">
              <ListBox Name="NodesListBox" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="10,9,12,9">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="34" Height="34" VerticalAlignment="Center">
                        <Ellipse Fill="{StaticResource AvatarBrush}" />
                        <TextBlock Text="{Binding Initial}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource SurfaceRaisedBrush}" StrokeThickness="2" Style="{StaticResource StatusDotStyle}" />
                      </Grid>
                      <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                          <Run Text="{Binding RoleDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding HopsDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Address, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding LinkQualityStatusDisplay}">
                        <StackPanel Orientation="Horizontal" Height="13" VerticalAlignment="Center">
                          <Rectangle Height="4">
                            <Rectangle.Style>
                              <Style TargetType="{x:Type Rectangle}" BasedOn="{StaticResource SignalBarStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SignalBar1Lit}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource MetricBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Rectangle.Style>
                          </Rectangle>
                          <Rectangle Height="7">
                            <Rectangle.Style>
                              <Style TargetType="{x:Type Rectangle}" BasedOn="{StaticResource SignalBarStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SignalBar2Lit}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource MetricBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Rectangle.Style>
                          </Rectangle>
                          <Rectangle Height="10">
                            <Rectangle.Style>
                              <Style TargetType="{x:Type Rectangle}" BasedOn="{StaticResource SignalBarStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SignalBar3Lit}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource MetricBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Rectangle.Style>
                          </Rectangle>
                          <Rectangle Height="13">
                            <Rectangle.Style>
                              <Style TargetType="{x:Type Rectangle}" BasedOn="{StaticResource SignalBarStyle}">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding SignalBar4Lit}" Value="True">
                                    <Setter Property="Fill" Value="{StaticResource MetricBrush}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Rectangle.Style>
                          </Rectangle>
                        </StackPanel>
                        <TextBlock Text="{Binding RssiDisplay}" FontSize="11" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center" />
                      </StackPanel>
                      <Border Grid.Column="3" Style="{StaticResource StatusPillStyle}">
                        <TextBlock Style="{StaticResource StatusPillTextStyle}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </GroupBox>

            <GroupBox Header="Mesh Bandwidth">
              <StackPanel>
                <Border Height="132" Style="{StaticResource InsetBorderStyle}">
                  <Grid Margin="10">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                      </Grid.RowDefinitions>
                      <Border Grid.Row="0" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Top" />
                      <Border Grid.Row="1" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Top" />
                      <Border Grid.Row="2" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Top" />
                      <Border Grid.Row="3" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Bottom" />
                    </Grid>
                    <Canvas Name="BandwidthChartCanvas" Background="Transparent" ClipToBounds="True">
                      <Polyline Name="BandwidthLine" Stroke="{StaticResource BandwidthBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                      <Ellipse Name="BandwidthMarker" Width="7" Height="7" Fill="{StaticResource BandwidthBrush}" Visibility="Collapsed" />
                    </Canvas>
                    <StackPanel Name="BandwidthEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Name="BandwidthStatusText" Text="Connect to begin sampling" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                      <TextBlock Text="Conservative direct-link capacity" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Margin="2,8,2,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Last 60 seconds" Style="{StaticResource CaptionTextStyle}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="10" Height="3" CornerRadius="1.5" Background="{StaticResource BandwidthBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Estimated, Mbps" Margin="5,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Mesh Throughput">
              <StackPanel>
                <Border Height="132" Style="{StaticResource InsetBorderStyle}">
                  <Grid Margin="10">
                    <Grid>
                      <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                      </Grid.RowDefinitions>
                      <Border Grid.Row="0" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Top" />
                      <Border Grid.Row="1" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Top" />
                      <Border Grid.Row="2" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Top" />
                      <Border Grid.Row="3" Height="1" Background="{StaticResource GridLineBrush}" VerticalAlignment="Bottom" />
                    </Grid>
                    <Canvas Name="ThroughputChartCanvas" Background="Transparent" ClipToBounds="True">
                      <Polyline Name="ThroughputRxLine" Stroke="{StaticResource MetricBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                      <Polyline Name="ThroughputTxLine" Stroke="{StaticResource TxBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                      <Ellipse Name="ThroughputRxMarker" Width="7" Height="7" Fill="{StaticResource MetricBrush}" Visibility="Collapsed" />
                      <Ellipse Name="ThroughputTxMarker" Width="7" Height="7" Fill="{StaticResource TxBrush}" Visibility="Collapsed" />
                    </Canvas>
                    <StackPanel Name="ThroughputEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Name="ThroughputStatusText" Text="Connect to begin sampling" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" HorizontalAlignment="Center" />
                      <TextBlock Text="Actual HaLow RX and TX traffic" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Border>
                <Grid Margin="2,8,2,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Last 60 seconds" Style="{StaticResource CaptionTextStyle}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Border Width="10" Height="3" CornerRadius="1.5" Background="{StaticResource MetricBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="RX" Margin="5,0,12,0" Style="{StaticResource CaptionTextStyle}" />
                    <Border Width="10" Height="3" CornerRadius="1.5" Background="{StaticResource TxBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="TX, Mbps" Margin="5,0,0,0" Style="{StaticResource CaptionTextStyle}" />
                  </StackPanel>
                </Grid>
                <TextBlock Name="UtilizationStatusText" Text="Waiting for bandwidth and throughput samples" Margin="2,8,2,0" Style="{StaticResource CaptionTextStyle}" />
              </StackPanel>
            </GroupBox>

            <GroupBox Header="Mesh Events">
              <Grid>
                <ListBox Name="MeshEventsListBox" Height="190" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="Cursor" Value="Arrow" />
                      <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="3" CornerRadius="1.5" Margin="0,1,10,1">
                          <Border.Style>
                            <Style TargetType="{x:Type Border}">
                              <Setter Property="Background" Value="{StaticResource InfoBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding SeverityDisplay}" Value="WARNING">
                                  <Setter Property="Background" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SeverityDisplay}" Value="CRITICAL">
                                  <Setter Property="Background" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                        <StackPanel Grid.Column="1">
                          <TextBlock FontSize="11.5" TextWrapping="Wrap" Text="{Binding Message}" />
                          <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="{Binding TimeDisplay, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SeverityDisplay, Mode=OneWay}" />
                          </TextBlock>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Name="MeshEventsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="No mesh events yet" FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="Node and link changes will appear here" Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== TOPOLOGY ============================== -->
      <TabItem Header="Topology">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="8,8,8,4">
            <Border Name="TopologyPlaceholder" Style="{StaticResource CardBorderStyle}" Padding="16,22">
              <TextBlock Text="Connect to OpenMANET to view the live mesh topology." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>
            <StackPanel Name="TopologyContent" Visibility="Collapsed">
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="10" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="10" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="MESH HEALTH" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding HealthDisplay}" Style="{StaticResource HealthTextStyle}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="ALGORITHM" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding AlgorithmDisplay}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="NODES" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding Nodes.Count}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="DIRECT LINKS" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding DirectLinkCount}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="BLOS LINKS" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Text="{Binding BlosLinkCount}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                  <StackPanel>
                    <TextBlock Text="GOSSIP COVERAGE" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Margin="0,4,0,0" FontSize="18" FontWeight="SemiBold" Text="{Binding GossipCoverageDisplay}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </Grid>

              <GroupBox Padding="0">
                <GroupBox.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Live Topology" />
                      <TextBlock Text="Paths from the local node" Style="{StaticResource CaptionTextStyle}" FontWeight="Normal" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,3,9,3" Background="{StaticResource SuccessTintBrush}" CornerRadius="9" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="LIVE" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </GroupBox.Header>
                <StackPanel>
                  <Border Margin="14,10,14,0" Style="{StaticResource InsetBorderStyle}" ClipToBounds="True">
                    <Canvas Name="TopologyCanvas" Height="250" MinWidth="220" Background="Transparent" />
                  </Border>
                  <Grid Margin="16,10,16,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Local" Style="{StaticResource CaptionTextStyle}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource MetricBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Gateway" Style="{StaticResource CaptionTextStyle}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#5B6475" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Mesh node" Style="{StaticResource CaptionTextStyle}" />
                      </StackPanel>
                    </WrapPanel>
                    <WrapPanel Grid.Column="1" Margin="8,0,0,0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <Rectangle Width="14" Height="2" Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="Path" Style="{StaticResource CaptionTextStyle}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Rectangle Width="14" Height="2" Fill="{StaticResource WarningBrush}" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="BLOS" Style="{StaticResource CaptionTextStyle}" />
                      </StackPanel>
                    </WrapPanel>
                  </Grid>
                </StackPanel>
              </GroupBox>

              <GroupBox Header="Nodes">
                <ListBox Name="TopologyNodesListBox" ItemsSource="{Binding Nodes}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="12,9">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding NameDisplay}" />
                          <TextBlock Grid.Column="1" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,0,0" Text="{Binding RoleDisplay}" />
                        </Grid>
                        <TextBlock Margin="0,3,0,0" FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis">
                          <Run Text="{Binding HopsDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding RouteDisplay, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SegmentDisplay, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Margin="0,2,0,0" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Text="{Binding GossipDisplay}" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </GroupBox>

              <GroupBox Header="Links">
                <ItemsControl ItemsSource="{Binding Edges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" Padding="12,9" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding LinkDisplay}" />
                          <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource SecondaryTextBrush}">
                              <Run Text="{Binding TypeDisplay, Mode=OneWay}" /><Run Text=" · Metric " /><Run Text="{Binding MetricDisplay, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0" Text="{Binding PathDisplay}">
                              <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                  <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnMyPath}" Value="True">
                                      <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBlos}" Value="True">
                                      <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </GroupBox>
              <TextBlock Margin="4,0,0,8" Style="{StaticResource CaptionTextStyle}">
                <Run Text="Snapshot collected" /> <Run Text="{Binding CollectedAtDisplay, Mode=OneWay}" />
              </TextBlock>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== NODES ============================== -->
      <TabItem Header="Nodes">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,8,8,4">
            <ComboBox Name="LinkQualityNodeComboBox" Margin="0,0,0,12" TextSearch.TextPath="Name" HorizontalContentAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource StatusDotStyle}" />
                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Border Name="NodeDetailsPanel" Style="{StaticResource CardBorderStyle}" Padding="16,14">
              <Grid>
                <TextBlock Name="NodeDetailsPlaceholder" Text="Select a node to view its link quality." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8" HorizontalAlignment="Center" />
                <StackPanel Name="NodeDetailsContent" Visibility="Collapsed">
                  <!-- Identity header -->
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="42" Height="42">
                      <Ellipse Fill="{StaticResource AvatarBrush}" />
                      <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                      <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" Text="{Binding StatusDetailDisplay}" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource StatusPillStyle}">
                      <TextBlock Style="{StaticResource StatusPillTextStyle}" />
                    </Border>
                  </Grid>

                  <!-- Link summary -->
                  <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12,10">
                      <StackPanel>
                        <TextBlock Text="LINK QUALITY" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Text="{Binding LinkQualityStatusDisplay}">
                          <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                              <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding LinkQualityStatusDisplay}" Value="Excellent">
                                  <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LinkQualityStatusDisplay}" Value="Good">
                                  <Setter Property="Foreground" Value="#9BDB6A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LinkQualityStatusDisplay}" Value="Fair">
                                  <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LinkQualityStatusDisplay}" Value="Poor">
                                  <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12,10">
                      <StackPanel>
                        <TextBlock Text="AVERAGE RSSI" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource MetricBrush}" Text="{Binding RssiDisplay}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <TextBlock Text="IDENTITY" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Role" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding RoleDisplay}" />
                    <TextBlock Grid.Row="1" Text="IP address" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding Address}" />
                    <TextBlock Grid.Row="2" Text="MAC" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding MacAddress}" />
                  </Grid>

                  <TextBlock Text="CONNECTIVITY" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Status" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" Text="{Binding StatusDisplay}" />
                    <TextBlock Grid.Row="1" Text="Segment" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding SegmentDisplay}" />
                    <TextBlock Grid.Row="2" Text="Hops" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding HopsDisplay}" />
                    <TextBlock Grid.Row="3" Text="Route" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding RouteInterfaceDisplay}" />
                    <TextBlock Grid.Row="4" Text="Path type" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" FontWeight="SemiBold" Text="{Binding PathTypeDisplay}">
                      <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource ValueTextStyle}">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding PathTypeDisplay}" Value="BLOS">
                              <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="5" Text="Last reachable" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding LastPollDisplay}" />
                  </Grid>

                  <TextBlock Text="LINK" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Current RSSI" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding CurrentRssiDisplay}" />
                    <TextBlock Grid.Row="1" Text="TX throughput" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ThroughputDisplay}" />
                    <TextBlock Grid.Row="2" Text="Last seen" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding LinkAgeDisplay}" />
                    <TextBlock Grid.Row="3" Text="Interface" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding LinkInterfaceDisplay}" />
                    <TextBlock Grid.Row="4" Text="Link MAC" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding LinkHardwareAddressDisplay}" />
                    <TextBlock Grid.Row="5" Text="Direct links" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding DirectLinkCountDisplay}" />
                  </Grid>

                  <TextBlock Text="MESH HEALTH" Style="{StaticResource EyebrowTextStyle}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Topology" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,7" Text="{Binding TopologyStatusDisplay}" Style="{StaticResource HealthTextStyle}" />
                    <TextBlock Grid.Row="1" Text="Topology age" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding TopologyAgeDisplay}" />
                    <TextBlock Grid.Row="2" Text="Remote gateway" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding RemoteGatewayDisplay}" />
                  </Grid>

                  <TextBlock Text="LAST 60 MINUTES" Style="{StaticResource EyebrowTextStyle}" Margin="0,4,0,8" />
                  <Border Padding="12,10" Style="{StaticResource InsetBorderStyle}">
                    <StackPanel>
                      <TextBlock Name="NodeTrendStatusText" Text="Trend history begins after the first refresh" Margin="0,0,0,10" Style="{StaticResource CaptionTextStyle}" />
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RSSI" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Canvas Name="NodeRssiTrendCanvas" Grid.Column="1" Height="30" Background="Transparent" ClipToBounds="True">
                          <Polyline Name="NodeRssiTrendLine" Stroke="{StaticResource MetricBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                        </Canvas>
                        <TextBlock Name="NodeRssiTrendValueText" Grid.Column="2" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MetricBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bandwidth" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Canvas Name="NodeBandwidthTrendCanvas" Grid.Column="1" Height="30" Background="Transparent" ClipToBounds="True">
                          <Polyline Name="NodeBandwidthTrendLine" Stroke="{StaticResource BandwidthBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                        </Canvas>
                        <TextBlock Name="NodeBandwidthTrendValueText" Grid.Column="2" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BandwidthBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                      <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Hops" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Canvas Name="NodeHopsTrendCanvas" Grid.Column="1" Height="30" Background="Transparent" ClipToBounds="True">
                          <Polyline Name="NodeHopsTrendLine" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                        </Canvas>
                        <TextBlock Name="NodeHopsTrendValueText" Grid.Column="2" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Last seen" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                        <Canvas Name="NodeAgeTrendCanvas" Grid.Column="1" Height="30" Background="Transparent" ClipToBounds="True">
                          <Polyline Name="NodeAgeTrendLine" Stroke="{StaticResource InfoBrush}" StrokeThickness="1.75" StrokeLineJoin="Round" />
                        </Canvas>
                        <TextBlock Name="NodeAgeTrendValueText" Grid.Column="2" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== SYSTEM ============================== -->
      <TabItem Header="System">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="8,8,8,4">
            <Border Name="SystemDetailsPlaceholder" Style="{StaticResource CardBorderStyle}" Padding="16,22">
              <TextBlock Text="Connect to OpenMANET to view gateway system details." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            </Border>
            <StackPanel Name="SystemDetailsContent" Visibility="Collapsed">
              <GroupBox>
                <GroupBox.Header>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="System Health" />
                      <TextBlock Text="Findings for the connected node" Style="{StaticResource CaptionTextStyle}" FontWeight="Normal" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Name="HealthSummaryText" Grid.Column="1" Text="Offline" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                  </Grid>
                </GroupBox.Header>
                <ItemsControl Name="HealthFindingsItemsControl">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Padding="10,8" Margin="0,0,0,5" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="8">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Ellipse Width="7" Height="7" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,4,0,0" Fill="{Binding IndicatorBrush}" />
                          <TextBlock Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" Text="{Binding Message}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </GroupBox>

              <GroupBox Header="Platform Resources">
                <StackPanel>
                  <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="CPU load" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CpuLoadDisplay}" />
                  </Grid>
                  <ProgressBar Foreground="{StaticResource InfoBrush}" Margin="0,0,0,12" Value="{Binding CpuLoadValue, Mode=OneWay}" />
                  <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Memory" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding MemoryDisplay}" />
                  </Grid>
                  <ProgressBar Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12" Value="{Binding MemoryUsagePercent, Mode=OneWay}" />
                  <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Overlay storage" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding OverlayDisplay}" />
                  </Grid>
                  <ProgressBar Foreground="{StaticResource BandwidthBrush}" Margin="0,0,0,14" Value="{Binding OverlayUsagePercent, Mode=OneWay}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="10" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12,9">
                      <StackPanel>
                        <TextBlock Text="UPTIME" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding UptimeDisplay}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12,9">
                      <StackPanel>
                        <TextBlock Text="CPU TEMPERATURE" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding TemperatureDisplay}" />
                      </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12,9">
                      <StackPanel>
                        <TextBlock Text="DEVICE TIME" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Text="{Binding DeviceTimeDisplay}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </StackPanel>
              </GroupBox>

              <GroupBox Header="Device Identity">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Hostname" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueTextStyle}" FontWeight="SemiBold" Text="{Binding HostnameDisplay}" />
                  <TextBlock Grid.Row="1" Text="Hardware" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding ModelDisplay}" />
                  <TextBlock Grid.Row="2" Text="Firmware" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding FirmwareDisplay}" />
                  <TextBlock Grid.Row="3" Text="Kernel" Style="{StaticResource LabelTextStyle}" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Text="{Binding KernelDisplay}" />
                  <TextBlock Grid.Row="4" Text="Architecture" Style="{StaticResource LabelTextStyle}" Margin="0,0,8,0" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource ValueTextStyle}" Margin="0" Text="{Binding ArchitectureDisplay}" />
                </Grid>
              </GroupBox>

              <GroupBox Header="Network Interfaces">
                <ItemsControl ItemsSource="{Binding NetworkEntries}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
                        <StackPanel>
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding NameDisplay}" ToolTip="{Binding InterfaceDisplay}" />
                            <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="9" Padding="8,2,9,3">
                              <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                  <Setter Property="Background" Value="{StaticResource WarningTintBrush}" />
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding StateDisplay}" Value="Connected">
                                      <Setter Property="Background" Value="{StaticResource SuccessTintBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StateDisplay}" Value="Not Connected">
                                      <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock FontSize="10.5" FontWeight="SemiBold" Text="{Binding StateDisplay}">
                                <TextBlock.Style>
                                  <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding StateDisplay}" Value="Connected">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding StateDisplay}" Value="Not Connected">
                                        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </Border>
                          </Grid>
                          <TextBlock FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding DetailDisplay}" />
                          <TextBlock FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" Text="{Binding TrafficDisplay}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </GroupBox>
              <TextBlock Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" Margin="0,0,4,8" Text="{Binding CollectedAtDisplay, StringFormat=Refreshed at {0}}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- ============================== SETTINGS ============================== -->
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="8,8,8,4">
            <GroupBox>
              <GroupBox.Header>
                <StackPanel>
                  <TextBlock Text="Connection" />
                  <TextBlock Text="The OpenMANET node this WinTAK client monitors" Style="{StaticResource CaptionTextStyle}" FontWeight="Normal" Margin="0,2,0,0" />
                </StackPanel>
              </GroupBox.Header>
              <StackPanel>
                <Grid Name="ConnectionSettingsPanel">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="10" />
                      <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP address or hostname" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,5" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,5" />
                    <TextBox Name="GatewayHostTextBox" Grid.Row="1" Grid.Column="0" Text="10.41.0.1" />
                    <TextBox Name="GatewayPortTextBox" Grid.Row="1" Grid.Column="2" Text="8081" TextAlignment="Center" />
                  </Grid>
                  <TextBlock Grid.Row="1" Text="Username" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,5" />
                  <TextBox Name="UsernameTextBox" Grid.Row="2" Margin="0,0,0,12" />
                  <TextBlock Grid.Row="3" Text="Password" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,0,0,5" />
                  <PasswordBox Name="PasswordInput" Grid.Row="4" />
                  <TextBlock Name="TransportModeText" Grid.Row="5" Margin="0,10,0,0" Text="Secure mode: trusted HTTPS frontend with the /auth and /rpc proxies and normal Windows certificate validation." Style="{StaticResource CaptionTextStyle}" />
                  <CheckBox Name="AllowInsecureHttpCheckBox" Grid.Row="6" Margin="0,12,0,0" ToolTip="HTTP provides no transport encryption and exposes the username, password, bearer token, and telemetry to interception or modification. Enable only when HTTPS is unavailable and the management path is otherwise protected.">
                    <TextBlock Text="I understand the risk: use legacy direct HTTP (port 8087)" Foreground="{StaticResource WarningBrush}" FontSize="11.5" TextWrapping="Wrap" />
                  </CheckBox>
                </Grid>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button Name="ConnectButton" Grid.Column="0" Height="38" Style="{StaticResource PrimaryButtonStyle}" Content="Connect" />
                  <Button Name="RefreshButton" Grid.Column="2" Height="38" Content="Refresh" IsEnabled="False" />
                </Grid>
              </StackPanel>
            </GroupBox>
            <GroupBox>
              <GroupBox.Header>
                <StackPanel>
                  <TextBlock Text="Diagnostics" />
                  <TextBlock Text="Snapshots for troubleshooting. Credentials are never included." Style="{StaticResource CaptionTextStyle}" FontWeight="Normal" Margin="0,2,0,0" />
                </StackPanel>
              </GroupBox.Header>
              <StackPanel>
                <TextBlock Text="The support snapshot pseudonymizes network identifiers and omits process details. The full snapshot contains operationally sensitive network information; review it before sharing." Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,12" />
                <Button Name="ExportDiagnosticsButton" Height="36" Content="Export Redacted Support Snapshot" />
                <Button Name="ExportFullDiagnosticsButton" Height="36" Margin="0,8,0,0" Content="Export Full Operational Snapshot" />
              </StackPanel>
            </GroupBox>
            <TextBlock Name="GatewayStatusText" Text="Not Connected" Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
